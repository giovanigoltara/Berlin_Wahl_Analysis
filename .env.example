# Copy to .env (gitignored) and adjust if needed. Used by docker-compose.yml and src/*.py.
POSTGRES_USER=hgv
POSTGRES_PASSWORD=hgv
POSTGRES_DB=hgv
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Google Cloud project registered for Earth Engine (see README, "Manual setup").
EE_PROJECT=
# Optional, for unattended runs: service-account JSON key, raw or base64. Leave empty to use the
# credentials stored by `earthengine authenticate`. Never commit a key.
EE_SERVICE_ACCOUNT_KEY=
